        { "text": "ut", "roman": "oot", "meaning": "out", "audio": "audio/sv/words/sv-u-04.mp3" },
        { "text": "ugn", "roman": "oongn", "meaning": "oven", "audio": "audio/sv/words/sv-u-05.mp3" },
