      "name": "Y",
      "romanization": "ew",
      "ipa": "/yː/",
      "letterAudio": "audio/sv/letters/sv-y.mp3",
      "memoryTrick": "Round your lips tightly as for 'oo', but say 'ee' — the same trick as Swedish 'u' but slightly more open. It's like the French 'u' in 'tu' or German 'ü'. Very front, very rounded, very Swedish!",
      "words": [
        { "text": "yta", "roman": "ee-tah", "meaning": "surface", "audio": "audio/sv/words/sv-y-01.mp3" },
        { "text": "yrke", "roman": "eer-keh", "meaning": "profession", "audio": "audio/sv/words/sv-y-02.mp3" },
