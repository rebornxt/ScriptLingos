      "char": "ໜ",
      "name": "Ho No (ligature of ho + no)",
      "romanization": "n (high class)",
      "ipa": "/n/",
      "letterAudio": "audio/lo/letters/lo-no-ho-no.mp3",
      "memoryTrick": "ໜ is a single-character ligature combining ຫ (high-class marker) + ນ (no). It makes the same 'n' sound as ນ but behaves as a high-class consonant for tone rules. A compact letter!",
      "words": [
        { "text": "ໜຶ່ງ", "roman": "nueng", "meaning": "one", "emoji": "1️⃣", "audio": "audio/lo/words/lo-no-ho-no-01.mp3" },
        { "text": "ໜັງ", "roman": "nang", "meaning": "leather, skin", "audio": "audio/lo/words/lo-no-ho-no-02.mp3" },
        { "text": "ໜ້າ", "roman": "naa", "meaning": "face, page, front", "audio": "audio/lo/words/lo-no-ho-no-03.mp3" },
        { "text": "ໜາວ", "roman": "naau", "meaning": "cold (weather)", "emoji": "🥶", "audio": "audio/lo/words/lo-no-ho-no-04.mp3" },
        { "text": "ໜີ", "roman": "nii", "meaning": "to flee, to escape", "audio": "audio/lo/words/lo-no-ho-no-05.mp3" },
        { "text": "ໜຽວ", "roman": "niao", "meaning": "sticky", "audio": "audio/lo/words/lo-no-ho-no-06.mp3" }
      ]
    },
    {
      "id": "lo-mo-ho-mo",
      "char": "ໝ",
      "name": "Ho Mo (ligature of ho + mo)",
      "romanization": "m (high class)",
      "ipa": "/m/",
      "letterAudio": "audio/lo/letters/lo-mo-ho-mo.mp3",
      "memoryTrick": "ໝ is a single-character ligature combining ຫ + ມ. Same 'm' sound as ມ but a high-class consonant. Very common — you'll see it in the word for 'dog' (ໝາ)!",
      "words": [
        { "text": "ໝາ", "roman": "maa", "meaning": "dog", "emoji": "🐕", "audio": "audio/lo/words/lo-mo-ho-mo-01.mp3" },
        { "text": "ໝູ່", "roman": "muu", "meaning": "friend, group", "audio": "audio/lo/words/lo-mo-ho-mo-02.mp3" },
        { "text": "ໝີ", "roman": "mii", "meaning": "bear", "emoji": "🐻", "audio": "audio/lo/words/lo-mo-ho-mo-03.mp3" },
        { "text": "ໝາກ", "roman": "maak", "meaning": "fruit, betel nut", "audio": "audio/lo/words/lo-mo-ho-mo-04.mp3" },
        { "text": "ໝໍ້", "roman": "mɔɔ", "meaning": "pot, cooking pot", "audio": "audio/lo/words/lo-mo-ho-mo-05.mp3" },
        { "text": "ໝົດ", "roman": "mot", "meaning": "all, finished, exhausted", "audio": "audio/lo/words/lo-mo-ho-mo-06.mp3" },
        { "text": "ໝື່ນ", "roman": "muun", "meaning": "ten thousand", "audio": "audio/lo/words/lo-mo-ho-mo-07.mp3" }
      ]
    },
    {
      "id": "lo-vowel-a",
      "char": "◌ະ",
      "name": "Sara A (short a)",
      "romanization": "a",
      "ipa": "/aʔ/, /a/",
      "letterAudio": "audio/lo/letters/lo-vowel-a.mp3",
      "memoryTrick": "Written to the RIGHT of the consonant. A quick, short 'a' like 'a' in 'about'. In closed syllables it marks a short vowel before the final consonant. The medial form ◌ັ◌ is called Mai Kan."
    },
    {
      "id": "lo-vowel-aa",
      "char": "◌າ",
      "name": "Sara Aa (long a)",
      "romanization": "aa",
      "ipa": "/aː/",
      "letterAudio": "audio/lo/letters/lo-vowel-aa.mp3",
      "memoryTrick": "Written to the RIGHT of the consonant. A long, open 'ahh' like 'a' in 'father'. One of the most common vowels — you'll see it everywhere, like in ປາ (fish)."
    },
    {
      "id": "lo-vowel-i",
      "char": "◌ິ",
      "name": "Sara I (short i)",
      "romanization": "i",
      "ipa": "/i/",
      "letterAudio": "audio/lo/letters/lo-vowel-i.mp3",
      "memoryTrick": "Written ABOVE the consonant. A short 'i' like 'i' in 'sit'. The little hook above the letter makes a quick, clipped sound."
    },
    {
      "id": "lo-vowel-ii",
      "char": "◌ີ",
      "name": "Sara Ii (long i)",
      "romanization": "ii",
      "ipa": "/iː/",
      "letterAudio": "audio/lo/letters/lo-vowel-ii.mp3",
      "memoryTrick": "Written ABOVE the consonant. A long 'ee' like 'ee' in 'see'. The taller mark above the letter stretches the sound out — like in ດີ (good)."
    },
    {
      "id": "lo-vowel-ue",
      "char": "◌ຶ",
      "name": "Sara Ue (short ɯ)",
      "romanization": "ue",
      "ipa": "/ɯ/",
      "letterAudio": "audio/lo/letters/lo-vowel-ue.mp3",
      "memoryTrick": "Written ABOVE the consonant. A short unrounded 'eu' sound — purse your lips like saying 'oo' but say 'ee' instead. No English equivalent; closest is a grunt-like vowel."
    },
    {
      "id": "lo-vowel-uee",
      "char": "◌ື",
      "name": "Sara Uee (long ɯ)",
      "romanization": "uee",
      "ipa": "/ɯː/",
      "letterAudio": "audio/lo/letters/lo-vowel-uee.mp3",
      "memoryTrick": "Written ABOVE the consonant. The long version of the unrounded 'eu'. Hold the sound twice as long. Think of the sound in ມື (hand) — a deeper, stretched 'eu'."
    },
    {
      "id": "lo-vowel-u",
      "char": "◌ຸ",
      "name": "Sara U (short u)",
      "romanization": "u",
      "ipa": "/u/",
      "letterAudio": "audio/lo/letters/lo-vowel-u.mp3",
      "memoryTrick": "Written BELOW the consonant — it dips down like a little cup! A short 'u' like 'u' in 'put'. Quick, rounded-lip sound beneath the letter."
    },
    {
      "id": "lo-vowel-uu",
      "char": "◌ູ",
      "name": "Sara Uu (long u)",
      "romanization": "uu",
      "ipa": "/uː/",
      "letterAudio": "audio/lo/letters/lo-vowel-uu.mp3",
      "memoryTrick": "Written BELOW the consonant with a longer tail. A long 'oo' like 'oo' in 'moon'. The elongated tail suggests holding the sound — like in ປູ (crab)."
    },
    {
      "id": "lo-vowel-e",
      "char": "ເ◌",
      "name": "Sara E (long e)",
      "romanization": "ee",
      "ipa": "/eː/",
      "letterAudio": "audio/lo/letters/lo-vowel-e.mp3",
      "memoryTrick": "Written BEFORE the consonant (even though it's pronounced after!). A long 'ay' like 'ay' in 'say' without the glide. Surprising but common — the vowel sign sits to the left."
    },
    {
      "id": "lo-vowel-ae",
      "char": "ແ◌",
      "name": "Sara Ae (long ɛ)",
      "romanization": "ae",
      "ipa": "/ɛː/",
      "letterAudio": "audio/lo/letters/lo-vowel-ae.mp3",
      "memoryTrick": "Written BEFORE the consonant. A long 'eh' like 'e' in 'bed' but held longer. Think of ແມ່ (mother) — the open, flat 'ae' sound."
    },
    {
      "id": "lo-vowel-o",
      "char": "ໂ◌",
      "name": "Sara O (long o)",
      "romanization": "oo",
      "ipa": "/oː/",
      "letterAudio": "audio/lo/letters/lo-vowel-o.mp3",
      "memoryTrick": "Written BEFORE the consonant. A long 'oh' like 'o' in 'go' without the w-glide. Pure, round 'o' — like in ໂຮງ (building)."
    },
    {
      "id": "lo-vowel-ai-muan",
      "char": "ໃ◌",
      "name": "Sara Ai Mai Muan (rolled stem)",
      "romanization": "ai",
      "ipa": "/aj/",
      "letterAudio": "audio/lo/letters/lo-vowel-ai-muan.mp3",
      "memoryTrick": "Written BEFORE the consonant. Mai Muan means 'rolled stem' — the loop is rolled inward. Makes the 'ai' diphthong like 'eye' or 'Thai'. Used in ໃຈ (heart)."
    },
    {
      "id": "lo-vowel-ai-mai",
      "char": "ໄ◌",
      "name": "Sara Ai Mai Mai (unwound stem)",
      "romanization": "ai",
      "ipa": "/aj/",
      "letterAudio": "audio/lo/letters/lo-vowel-ai-mai.mp3",
      "memoryTrick": "Written BEFORE the consonant. Mai Mai means 'unwound stem' — the loop points outward. Same 'ai' sound as ໃ. More common than ໃ; used in ໄກ່ (chicken)."
    },
    {
      "id": "lo-nikkhahit",
      "char": "◌ໍ",
      "name": "Nikkhahit (long open-o marker)",
      "romanization": "ɔɔ",
      "ipa": "/ɔː/",
      "letterAudio": "audio/lo/letters/lo-nikkhahit.mp3",
      "memoryTrick": "A small circle written ABOVE the consonant. It marks the long 'aw' sound like 'aw' in 'law'. Originally from Pali, it's used in everyday Lao words like ພໍ່ (father)."
    },
    {
      "id": "lo-mai-kan",
      "char": "◌ັ",
      "name": "Mai Kan (shortener / ear stem)",
      "romanization": "(shortens vowel)",
      "letterAudio": "audio/lo/letters/lo-mai-kan.mp3",
      "memoryTrick": "A small mark ABOVE the consonant that shortens a vowel or marks a closed syllable. Called 'ear stem' for its shape. Essential for distinguishing short-vowel words like ຈັບ (to catch)."
    },
    {
      "id": "lo-mai-kong",
      "char": "◌ົ",
      "name": "Mai Kong (straight stem)",
      "romanization": "(used in o-combinations)",
      "letterAudio": "audio/lo/letters/lo-mai-kong.mp3",
      "memoryTrick": "A small mark ABOVE the consonant used in vowel combinations to create the 'o' sound. Called 'straight stem'. You'll see it in words like ຄົນ (person) where it combines with the consonant to make /khon/."
    },
    {
      "id": "lo-tone-mai-ek",
      "char": "◌່",
      "name": "Mai Ek (tone mark 1)",
      "romanization": "(tone: high-falling on mid/high class, low on low class)",
      "letterAudio": "audio/lo/letters/lo-tone-mai-ek.mp3",
      "memoryTrick": "Written ABOVE the consonant. Mai Ek produces a high-falling tone with mid and high consonants. Think 'ék' — the voice starts high and drops. Most commonly used tone mark in Lao."
    },
    {
      "id": "lo-tone-mai-tho",
      "char": "◌້",
      "name": "Mai Tho (tone mark 2)",
      "romanization": "(tone: low on mid/high, falling on low class)",
      "letterAudio": "audio/lo/letters/lo-tone-mai-tho.mp3",
      "memoryTrick": "Written ABOVE the consonant with a longer curl than Mai Ek. Mai Tho produces a low tone with mid/high class consonants. The curling tail suggests the voice curling downward."
    },
    {
      "id": "lo-tone-mai-ti",
      "char": "◌໊",
      "name": "Mai Ti (tone mark 3)",
      "romanization": "(tone: high-rising)",
      "letterAudio": "audio/lo/letters/lo-tone-mai-ti.mp3",
      "memoryTrick": "Written ABOVE the consonant. Mai Ti is rare in modern Lao — used mainly in Pali/Sanskrit loanwords and some dialects. Produces a high-rising tone."
    },
    {
      "id": "lo-tone-mai-catawa",
      "char": "◌໋",
      "name": "Mai Catawa (tone mark 4)",
      "romanization": "(tone: high-mid level)",
      "letterAudio": "audio/lo/letters/lo-tone-mai-catawa.mp3",
      "memoryTrick": "Written ABOVE the consonant. Mai Catawa is very rare — mostly in archaic or borrowed words. Named after the high-mid level tone it produces. The plus-shape suggests levelness."
    },
    {
      "id": "lo-kola",
      "char": "ໆ",
      "name": "Ko La (repetition mark)",
      "romanization": "(indicates repetition)",
      "letterAudio": "audio/lo/letters/lo-kola.mp3",
      "memoryTrick": "This little zigzag means 'repeat the previous word!' Like writing 'hello hello' as 'hello ໆ'. Similar to Thai ๆ (mai yamok). It saves space and looks like a double-check mark."
    },
    {
      "id": "lo-cancellation",
      "char": "◌໌",
      "name": "Cancellation Mark (karan)",
      "romanization": "(marks a silent letter)",
      "letterAudio": "audio/lo/letters/lo-cancellation.mp3",
      "memoryTrick": "Placed ABOVE a consonant to silence it — the letter is written but NOT pronounced. Used mainly in Pali, Sanskrit, and French loanwords where a written consonant has no sound in Lao."
    },
    {
      "id": "lo-ellipsis",
      "char": "ຯ",
      "name": "Lao Ellipsis (etc. mark)",
      "romanization": "(indicates etcetera / abbreviation)",
      "letterAudio": "audio/lo/letters/lo-ellipsis.mp3",
      "memoryTrick": "Used to indicate 'and so on' or an abbreviation — like '…' or 'etc.' in English. In formal Lao writing, you'll see ຯລຯ as shorthand for ແລະອື່ນໆ (and others)."
    },
    {
      "id": "lo-semivowel-lo",
      "char": "◌ຼ",
      "name": "Semivowel Sign Lo (ligature marker)",
      "romanization": "(combines with ຫ to make high-class l)",
      "letterAudio": "audio/lo/letters/lo-semivowel-lo.mp3",
      "memoryTrick": "A tiny curl placed BELOW ຫ to create the ຫຼ ligature — producing a high-class version of the 'l' sound. Think of it as a little helper that changes the tone of the following consonant."
    }
  ]
}
